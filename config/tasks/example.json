{
  "flow_name": "auto-notify-flow",
  "runtime_dir": "runtime/flow/latest",
  "steps": {
    "login": {
      "enabled": false,
      "config_path": "config/modules/autologin.json",
      "force_refresh": false
    },
    "download": {
      "enabled": true,
      "config_path": "config/modules/report_downloader.json",
      "dry_run": true,
      "debug": true
    },
    "compare": {
      "enabled": true,
      "config_path": "config/modules/report_compare.json",
      "generated_config_path": "runtime/flow/latest/compare_config.json",
      "download_report_name": "日通报导出"
    },
    "update_template": {
      "enabled": true,
      "config_path": "config/modules/template_updater.json",
      "generated_config_path": "runtime/flow/latest/template_updater_config.json"
    },
    "send_wecom": {
      "enabled": true,
      "base_config_path": "config/modules/excel_sender_wx.json",
      "generated_config_path": "runtime/flow/latest/excel_sender_config.json",
      "dry_run": true,
      "timeout": 30
    },
    "commit_template": {
      "enabled": true,
      "config_path": "config/modules/template_commit.json"
    }
  }
}
