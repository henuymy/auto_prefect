{
  "cookie_dump_path": "session/cookie_dump.json",
  "stage_session_dir": "session/stages",
  "stage_health_path": "session/stage_health.json",
  "legacy_cookie_dump_path": null,
  "required_stages": [
    "report_analysis",
    "smart_ops",
    "city_ops",
    "data_market"
  ],
  "allow_login": true,
  "login_timeout_seconds": 600,
  "login_max_attempts": 2,
  "login_retry_delay_seconds": 60,
  "login_lock_path": "session/locks/login.lock",
  "login_lock_wait_seconds": 1440,
  "login_lock_poll_seconds": 5,
  "login_lock_stale_seconds": 900,
  "browser_session_state_path": "session/browser-session.json",
  "browser": {
    "user_data_dir": "session/browser-profile"
  },
  "stage_probes": {
    "report_analysis": {
      "enabled": true,
      "method": "POST",
      "url": "https://usm.ha.cmcc:19011/bicpreport/client/getLoginName",
      "headers": {
        "Accept": "application/json, text/plain, */*",
        "Content-Type": "application/x-www-form-urlencoded",
        "Origin": "https://usm.ha.cmcc:19011",
        "Referer": "https://usm.ha.cmcc:19011/bicpreport/index.html"
      },
      "headers_from_cookies": {
        "Ssr-Token": "ssr-token"
      },
      "body_type": "form",
      "data": {},
      "success_json_path": "returnCode",
      "success_value": "0",
      "timeout_seconds": 8
    },
    "city_ops": {
      "enabled": true,
      "method": "POST",
      "url": "https://usm.ha.cmcc:19011/dszzCombat/dszzRestful/combatreal/base/getUserInfo",
      "headers": {
        "Accept": "*/*",
        "Content-Type": "application/json",
        "Origin": "https://usm.ha.cmcc:19011",
        "Referer": "https://usm.ha.cmcc:19011/dszzCombat/dszzWeb/h5combatplatform/"
      },
      "headers_from_session_storage": {
        "Uaptoken": "uapToken"
      },
      "body_type": "json",
      "data": {},
      "success_json_path": "reCode",
      "success_value": "0000",
      "connect_timeout_seconds": 2,
      "read_timeout_seconds": 5
    },
    "smart_ops": {
      "enabled": true,
      "method": "POST",
      "url": "https://usm.ha.cmcc:19011/zhyypt/smop/dszzBranch/regions/getNameById",
      "headers": {
        "Accept": "*/*",
        "Content-Type": "application/json",
        "Origin": "https://usm.ha.cmcc:19011",
        "Referer": "https://usm.ha.cmcc:19011/zhyypt/dist/"
      },
      "headers_from_session_storage": {
        "user-info": "zhyyptInfo.accessToken"
      },
      "body_type": "json",
      "data": {
        "area": "371"
      },
      "success_status_codes": [200],
      "success_json_path": "header.rspcode",
      "success_value": "0000",
      "timeout_seconds": 8
    }
  },
  "login_command": "{python_executable} -c \"from services.login_service import run_login; run_login('config/modules/login_config.json')\""
}
