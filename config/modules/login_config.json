{
  "login_url": "http://ngboss.ha.cmcc/uac/web3/jsp/login/login.jsp",
  "usm_host": "usm.ha.cmcc",
  "credentials": {
    "username": "",
    "password": ""
  },
  "app_login_entry": {
    "name": "大数据分析平台"
  },
  "otp_mode": "gotify",
  "otp_config": {
    "gotify_url": "",
    "client_token": "",
    "title_prefix": "10658221",
    "allowed_senders": ["10658221"],
    "required_keywords": ["动态密钥"],
    "code_regex": "(?<!\\d)(\\d{4,8})(?!\\d)",
    "preferred_code_lengths": [6],
    "timeout_seconds": 45,
    "poll_interval_seconds": 3,
    "max_request_count": 3,
    "retry_interval_seconds": 10,
    "message_ttl_seconds": 600,
    "trigger_grace_seconds": 120,
    "require_new_message": true,
    "fetch_limit": 20,
    "delete_after_success": true
  },
  "usm_cookie_apps": [
    {"stage": "report_analysis", "name": "报表分析系统"},
    {
      "stage": "smart_ops",
      "name": "智慧运营平台",
      "storage_ready": {
        "type": "session_storage",
        "path": "zhyyptInfo.accessToken",
        "timeout_seconds": 45
      }
    },
    {
      "stage": "city_ops",
      "name": "地市作战平台",
      "source_stage": "usm_console",
      "icon_src_contains": "dszzIcon",
      "storage_ready": {
        "type": "session_storage",
        "path": "uapToken",
        "timeout_seconds": 45
      }
    },
    {"stage": "data_market", "name": "数据超市"}
  ],
  "cookie_dump": {
    "enabled": true,
    "output_file": "runtime/cookies/cookie_dump.json"
  },
  "browser": {
    "keep_open_after_login": true,
    "session_state_path": "runtime/browser_session/session.json",
    "user_data_dir": "runtime/browser_session/edge_profile_auto_login",
    "window_width": 1920,
    "window_height": 1080,
    "implicit_wait": 10
  }
}
