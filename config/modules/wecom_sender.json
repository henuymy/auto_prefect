{
  "capture_defaults": {
    "mode": "used_range",
    "shrink_empty_edges": true,
    "engine": "pdf_render",
    "pdf_dpi": 300,
    "pdf_crop_whitespace": true,
    "excel_ready_timeout_seconds": 60,
    "excel_ready_poll_seconds": 0.2,
    "excel_active_printer": "Microsoft Print to PDF",
    "optimize_png": false,
    "png_colors": 256
  },
  "workbooks": [
    {
      "name": "通报工作簿",
      "file": "modules/wecom_sender/output/input.xlsx",
      "excel_open": {
        "update_links": false,
        "refresh_before_capture": false,
        "refresh_timeout_seconds": 120
      },
      "reports": []
    }
  ],
  "wecom": {
    "mode": "webhook",
    "webhook_url": ""
  },
  "output": {
    "runtime_dir": "modules/wecom_sender/output",
    "image_dir": "images",
    "package_file": "message_package.json",
    "preview_image_file": "preview.png",
    "send_result_file": "send_result.json",
    "intermediate_dir": "intermediates",
    "keep_intermediate_files": false,
    "cleanup_after_send": true
  }
}
