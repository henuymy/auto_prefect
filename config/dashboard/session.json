{
  "schema_version": 1,
  "autologin_config_path": "config/modules/autologin.json",
  "required_stage": "city_ops",
  "collection_lock_path": "runtime/locks/dashboard_collection.lock",
  "collection_lock_wait_seconds": 5,
  "collection_lock_poll_seconds": 1,
  "collection_lock_stale_seconds": 1800,
  "collection_database_lock_name": "auto_notify_dashboard_collection",
  "collection_database_lock_wait_seconds": 5,
  "collection_max_workers": 24,
  "collection_hard_max_workers": 32,
  "collection_timeout_seconds": 30,
  "collection_request_retries": 2,
  "collection_retry_delay_seconds": 0.5,
  "collection_retry_strategy": "affected_grid",
  "relation_missing_disable_threshold": 2,
  "database_transaction_retries": 3,
  "collection_report_config_path": "config/reports/家客和存量通报.json",
  "daily_report_config_path": "config/reports/爱家亲情网营业厅每日盯控.json",
  "daily_report_name": "日累计",
  "area_anomaly_directory": "runtime/dashboard/area_anomalies",
  "failure_report_directory": "runtime/dashboard/failure_reports",
  "run_store_type": "mysql",
  "run_store_dir": "runtime/dashboard/collection_runs",
  "retention": {
    "snapshot_retention_days": 7,
    "run_retention_days": 30,
    "acc_retention_days": 90,
    "active_run_timeout_minutes": 120
  }
}
