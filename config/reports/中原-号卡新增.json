{
  "name": "中原-号卡新增",
  "template_path": "templates/中原_李争艳_号卡新增.xlsx",
  "send": {
    "webhook_url": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=14957f64-6845-47eb-8bd7-61208f91096d",
    "workbook_name": "通报",
    "items": [
      {
        "type": "image",
        "sheet": "通报",
        "capture": {
          "mode": "used_range"
        }
      },
      {
        "type": "text",
        "sheet": "通报文字",
        "text": {
          "mode": "used_range"
        }
      }
    ]
  },
  "template_update": {
    "engine": "hybrid",
    "update_condition": "any_changed",
    "write_sheets": "all_compared",
    "send_when_same": true
  },
  "downloads": [
    {
      "name": "中原-lzy-区公司实时数据",
      "stage": "city_ops",
      "auth_preset": "自定义",
      "method": "POST",
      "url": "https://usm.ha.cmcc:19011/dszzCombat/dszzRestful/combatreal/getDetailByAreaAndIndex",
      "headers": {
        "Accept": "*/*",
        "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6",
        "Cache-Control": "no-cache",
        "Content-Type": "application/json",
        "Origin": "https://usm.ha.cmcc:19011",
        "Pragma": "no-cache",
        "Referer": "https://usm.ha.cmcc:19011/dszzCombat/dszzWeb/h5combatplatform/",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36 Edg/148.0.0.0"
      },
      "body_type": "json",
      "response_mode": "json_to_excel",
      "data": {
        "indCodes": "HKXZ,GTXZ,",
        "areaId": "AQ",
        "diyCodes": "HKXZ,GTXZ,",
        "areaType": null,
        "queryDate": "${today_yyyymmdd}"
      },
      "excel": {
        "data_path": "result.tableData",
        "sheet_name": "区公司实时数据",
        "columns": [
          {
            "field": "__level_name",
            "header": "层级"
          },
          {
            "field": "__parent_area_id",
            "header": "父级areaId"
          },
          {
            "field": "__request_area_id",
            "header": "请求areaId"
          },
          {
            "field": "areaName",
            "header": "名称"
          },
          {
            "field": "areaCode",
            "header": "编码"
          },
          {
            "field": "HKXZ",
            "header": "新入网_号卡新增",
            "type": "number"
          },
          {
            "field": "GTXZ",
            "header": "新入网_高套餐新增",
            "type": "number"
          }
        ]
      },
      "drilldown": {
        "data_path": "result.tableData",
        "request_area_field": "areaId",
        "next_area_field": "areaCode",
        "levels": [
          "网格",
          "渠道经理"
        ],
        "max_requests": 1000,
        "max_workers": 32,
        "skip_self_row": true
      },
      "source": "http_api",
      "headers_from_session_storage": {
        "uapToken": "uapToken"
      }
    }
  ],
  "compare_sources": [
    {
      "download_name": "中原-lzy-区公司实时数据",
      "engine": "openpyxl",
      "max_workers": 4,
      "sheet_mappings": [
        {
          "name": "区公司实时数据",
          "new_sheet_name": "区公司实时数据",
          "template_sheet_name": "区公司实时数据",
          "header_row": 1,
          "ignore_columns": [],
          "key_columns": []
        }
      ]
    }
  ],
  "id": "中原-号卡新增",
  "enabled": false,
  "description": "",
  "wait_for_change": {
    "enabled": false,
    "poll_interval_seconds": 300,
    "max_wait_minutes": 180
  },
  "deployment": {
    "enabled": true,
    "crons": [
      "0 9-18 * * *"
    ],
    "timezone": "Asia/Shanghai"
