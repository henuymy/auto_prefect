    {
      "name": "区公司实时数据",
      "stage": "city_ops",
      "auth_preset": "地市平台 Uaptoken",
      "method": "POST",
      "url": "https://usm.ha.cmcc:19011/dszzCombat/dszzRestful/combatreal/getDetailByAreaAndIndex",
      "headers": {
        "Accept": "*/*",
        "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8,en-GB;q=0.7,en-US;q=0.6",
        "Cache-Control": "no-cache",
        "Content-Type": "application/json",
        "Origin": "https://usm.ha.cmcc:19011",
        "Pragma": "no-cache",
        "Referer": "https://usm.ha.cmcc:19011/dszzCombat/dszzWeb/h5combatplatform/",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36 Edg/150.0.0.0"
      },
      "body_type": "json",
      "data": {
        "indCodes": "sgs_ajvwdz,",
        "areaId": "AQ",
        "diyCodes": "sgs_ajvwdz,",
        "areaType": null,
        "queryDate": "${today_yyyymmdd}"
      },
      "response_mode": "json_to_excel",
      "source": "http_api",
      "raw_body": "",
      "headers_from_session_storage": {
        "Uaptoken": "uapToken"
      },
      "excel": {
        "data_path": "result.tableData",
        "sheet_name": "区公司实时数据",
        "columns": [
          {
            "field": "areaCode",
            "header": "areaCode"
          },
          {
            "field": "areaName",
            "header": "areaName"
          },
          {
            "field": "sgs_ajvwdz",
            "header": "爱家亲情网(V网版)",
            "type": "number"
          }
        ]
      }
    },
    {
