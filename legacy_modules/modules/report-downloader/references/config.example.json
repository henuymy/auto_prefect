{
  "cookie_dump_path": "../autologin/runtime/cookie_dump.json",
  "output_dir": "runtime/downloads",
  "manifest_path": "runtime/download_manifest.json",
  "request_timeout_seconds": 120,
  "verify_ssl": false,
  "trust_env": false,
  "proxies": {
    "http": "http://127.0.0.1:7890",
    "https": "http://127.0.0.1:7890"
  },
  "reports": [
    {
      "enabled": true,
      "name": "报表名称",
      "stage": "report_analysis",
      "method": "POST",
      "url": "https://example.local/report/exportRptToExcle",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "headers_from_cookies": {
        "ssr-token": "ssr-token"
      },
      "csrf_headers_from_cookies": {
        "ssr-header": "ssr-token"
      },
      "allow_redirects": true,
      "data": {
        "area": "371",
        "templateId": "86283",
        "sheetIndex": "-1",
        "sheetName": "日通报",
        "type": "excel"
      }
    }
  ]
}
